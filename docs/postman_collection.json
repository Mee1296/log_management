{
    "info": {
        "_postman_id": "log-management-v1",
        "name": "Log Management System API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login Admin",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8000/api/v1/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Login Viewer A",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"viewerA\",\n    \"password\": \"A123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8000/api/v1/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Ingestion",
            "item": [
                {
                    "name": "Ingest Single Log",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "secret-key-123",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"tenant\": \"demoA\",\n    \"source\": \"api\",\n    \"message\": \"Test log for Demo A\",\n    \"severity\": 5\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8000/api/v1/ingest/manual",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "ingest",
                                "manual"
                            ]
                        }
                    }
                },
                {
                    "name": "Ingest Batch (Mixed Tenants)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "secret-key-123",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "[\n    {\n        \"tenant\": \"demoA\",\n        \"source\": \"batch\",\n        \"message\": \"Log for A\",\n        \"severity\": 1\n    },\n    {\n        \"tenant\": \"demoB\",\n        \"source\": \"batch\",\n        \"message\": \"Log for B\",\n        \"severity\": 1\n    }\n]",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8000/api/v1/ingest/batch",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "ingest",
                                "batch"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Search & Stats",
            "item": [
                {
                    "name": "Get Logs (Admin - All)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer admin-token",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:8000/api/v1/logs",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "logs"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs (Viewer A - Auto Tenant)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test(\"Only demoA logs returned\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.every(log => log.tenant === 'demoA')).to.be.true;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer viewerA-token",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:8000/api/v1/logs",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "logs"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs (Viewer A - Tenant B Forbidden)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 403\", function () {",
                                    "    pm.response.to.have.status(403);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer viewerA-token",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:8000/api/v1/logs?tenant=demoB",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "tenant",
                                    "value": "demoB"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Source Stats (Viewer A - Secured)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer viewerA-token",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:8000/api/v1/stats/sources",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "v1",
                                "stats",
                                "sources"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}