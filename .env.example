STATUS=example

# Database Configuration
POSTGRES_PASSWORD=password
POSTGRES_DB=DB_NAME
DATABASE_URL=postgresql://postgres:password@db:PORT_NUMBER/DB_NAME

# Security & Authentication
INGEST_API_KEY_NAME=example-key-name
INGEST_API_KEYS=example-ingest-key

ADMIN_USERNAME=example_admin
ADMIN_PASSWORD=example_pass

DEMO_VIEWERS_JSON='{"viewerA": {"password": "passwordA", "tenant": "demoA"},"viewerB": {"password": "passwordB", "tenant": "demoB"},"viewerC": {"password": "passwordC", "tenant": "demoC"}}'

# login blocking
AUTH_MAX_FAILURES=100
AUTH_WINDOW_MINUTES=100
AUTH_BLOCK_HOURS=100

# CORS (Frontend URL)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://your-production-domain.com
VITE_API_URL=http://localhost:PORT_NUMBER/api/v1